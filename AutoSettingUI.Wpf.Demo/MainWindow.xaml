<Window x:Class="AutoSettingUI.Wpf.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoSettingUI.Wpf.Demo"
        xmlns:controls="clr-namespace:AutoSettingUI.WPF.Controls;assembly=AutoSettingUI.WPF"
        xmlns:models="clr-namespace:AutoSettingUI.Core.Models;assembly=AutoSettingUI.Core"
        mc:Ignorable="d"
        Title="AutoSettingUI WPF Demo" Height="600" Width="900">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <HierarchicalDataTemplate x:Key="NavigationNodeTemplate"
                                  DataType="{x:Type models:NavigationNode}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Title}" />
        </HierarchicalDataTemplate>
        
        <!-- Custom Style for the Custom View Panel -->
        <Style x:Key="CustomSettingsPanelStyle" TargetType="controls:WpfAutoSettingPanel">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:WpfAutoSettingPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="{TemplateBinding NavigationWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Navigation Panel -->
                            <Border Grid.Column="0"
                                    Background="#FF2C3E50"
                                    BorderBrush="#FF34495E"
                                    BorderThickness="0,0,1,0"
                                    Visibility="{TemplateBinding ShowNavigation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TreeView x:Name="PART_Navigation"
                                              Margin="10"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              Foreground="White"
                                              ItemTemplate="{StaticResource NavigationNodeTemplate}">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                                                <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Padding" Value="5"/>
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                    </TreeView>
                                </ScrollViewer>
                            </Border>

                            <!-- Form Panel -->
                            <Border Grid.Column="1" Background="#FFF5F5F5">
                                <ScrollViewer x:Name="PART_FormScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ContentControl Content="{TemplateBinding Targets}"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="AutoSettingUI WPF Demo" 
                           Foreground="White" 
                           FontSize="20" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="ToggleNavButton" Content="Nav: True" 
                        Padding="10,5" Margin="10,0,5,0"
                        Click="ToggleNav_Click"/>
                <Button Grid.Column="2" x:Name="ToggleViewButton" Content="Switch to Custom View" 
                        Padding="10,5" Margin="5,0,0,0"
                        Click="ToggleView_Click"/>
            </Grid>
        </Border>

        <!-- Settings Panel - Default Style -->
        <controls:WpfAutoSettingPanel x:Name="SettingsPanel"
                                      Grid.Row="1"
                                      Title="Settings"
                                      ShowNavigation="True"
                                      NavigationWidth="200"/>

        <!-- Settings Panel - Custom Style -->
        <controls:WpfAutoSettingPanel x:Name="CustomSettingsPanel"
                                      Grid.Row="1"
                                      Title="Custom Styled Settings"
                                      ShowNavigation="True"
                                      NavigationWidth="250"
                                      Style="{StaticResource CustomSettingsPanelStyle}"
                                      Visibility="Collapsed"/>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="AddApp">Add App</Button>
            <Button Grid.Column="1" Click="AddUser">Add User</Button>
            <Button Grid.Column="2" Click="AddNetworkConfig">Add Network Config</Button>
        </Grid>
        
    </Grid>
</Window>
