<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <NoWarn>$(NoWarn);IL2026;IL2057;IL2067;IL2070;IL2072;IL2075;IL3050</NoWarn>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <MinVerAutoIncrement>patch</MinVerAutoIncrement>
        

        
        <!-- NuGet Packaging -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>AutoSettingUI.Avalonia</PackageId>
        <Version>1.0.0</Version>
        <Authors>Sakuya Starry</Authors>
        <Description>Avalonia UI implementation for AutoSettingUI - Declarative settings UI controls for Avalonia</Description>
        <PackageTags>settings;configuration;ui;avalonia;cross-platform</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/StarryXYJ/AutoSettingUI</PackageProjectUrl>
        <RepositoryUrl>https://github.com/StarryXYJ/AutoSettingUI.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.0.0" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.0.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.0" />
        <PackageReference Include="MinVer" Version="8.0.0-alpha.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\AutoSettingUI.Core\AutoSettingUI.Core.csproj" />
        <ProjectReference Include="..\AutoSettingUI.Extension.Shared\AutoSettingUI.Extension.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
